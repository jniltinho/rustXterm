<?xml version="1.0" encoding="utf-8"?>
<!-- Per-user MSI (add-windows-port design W9), built with wixl by package.sh. No `*` GUIDs:
     component GUIDs and the UpgradeCode are fixed here; ProductCode/PackageCode are UUIDv5 of the
     version (package.sh). The AUMID row (MsiShortcutProperty) is added by msibuild afterwards. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)" Name="rustXterm" Language="1033" Version="$(var.Version)"
           Manufacturer="rustXterm" UpgradeCode="D4ED26E1-2C57-4726-AEBE-A783C6C93645">
    <Package Id="$(var.PackageCode)" InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="rustXterm terminal and remote session manager" />
    <Media Id="1" Cabinet="rustxterm.cab" EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="rustXterm">
            <Component Id="App" Guid="4ABDC492-67D1-4E20-8543-E34D46D212AD">
              <File Id="rustxterm.exe" Name="rustxterm.exe" Source="$(var.SourceDir)/rustxterm.exe" />
              <File Id="rustxterm_cli.exe" Name="rustxterm-cli.exe" Source="$(var.SourceDir)/rustxterm-cli.exe" />
              <File Id="LICENSE" Name="LICENSE" Source="$(var.SourceDir)/LICENSE" />
              <File Id="ATTRIBUTION.md" Name="ATTRIBUTION.md" Source="$(var.SourceDir)/ATTRIBUTION.md" />
              <File Id="NOTICES" Name="THIRD-PARTY-NOTICES.txt" Source="$(var.SourceDir)/THIRD-PARTY-NOTICES.txt" />
              <File Id="README.txt" Name="README.txt" Source="$(var.SourceDir)/README.txt" />
              <RegistryValue Root="HKCU" Key="Software\rustXterm" Name="InstallDir" Type="string"
                             Value="[INSTALLDIR]" KeyPath="yes" />
              <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenu" Guid="EF655CEB-9B1B-4EDC-861D-0BBA5B6C8A6E">
          <Shortcut Id="StartMenuShortcut" Name="rustXterm" Description="Terminal and remote session manager"
                    Target="[INSTALLDIR]rustxterm.exe" WorkingDirectory="INSTALLDIR" />
          <RegistryValue Root="HKCU" Key="Software\rustXterm" Name="StartMenuShortcut" Type="integer"
                         Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="App" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Product>
</Wix>
